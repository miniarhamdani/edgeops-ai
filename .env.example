# ============================================================
# EdgeOps AI — Environment Configuration
# Copy this file to .env and adjust values
# ============================================================

# ----- Database -----
POSTGRES_USER=edgeops
POSTGRES_PASSWORD=edgeops_secret
POSTGRES_DB=edgeops
DATABASE_URL=postgresql://edgeops:edgeops_secret@localhost:5432/edgeops

# ----- Ollama LLM -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ----- Cloud Backend -----
CLOUD_API_URL=http://localhost:8000
CLOUD_API_KEY=dev-secret-key-change-in-prod

# ----- Edge Nodes -----
EDGE_CONTAMINATION=0.05         # Isolation Forest contamination rate (0.01 - 0.5)
EDGE_TRAINING_SAMPLES=500       # Samples before model is trained
EDGE_SEND_INTERVAL=5            # Seconds between sensor readings
NUM_EDGE_NODES=5                # Number of simulated edge nodes

# ----- Streamlit -----
STREAMLIT_SERVER_PORT=8501
DASHBOARD_REFRESH_INTERVAL=5    # Seconds between dashboard auto-refresh
